function show_infobox() {
    infobox.style.display = "block";  // o CSS já centraliza a caixa
}

// Encaixa a tela do jogo (640x360) na janela inteira, mantendo a proporção 16:9.
// Roda ao abrir, ao girar o celular, ao redimensionar e de tempos em tempos.
function ajustarTela() {
    const c = document.getElementById("canvas");
    if (!c || c.width < 2 || c.height < 2) return;  // o jogo ainda não criou a tela
    const vv = window.visualViewport;
    const largura = vv ? vv.width : window.innerWidth;
    const altura = vv ? vv.height : window.innerHeight;
    const escala = Math.min(largura / c.width, altura / c.height);
    const w = Math.floor(c.width * escala) + "px";
    const h = Math.floor(c.height * escala) + "px";
    if (c.style.width !== w || c.style.height !== h) {
        c.style.width = w;
        c.style.height = h;
    }
}
window.ajustarTela = ajustarTela;
window.addEventListener("resize", ajustarTela);
window.addEventListener("orientationchange", () => setTimeout(ajustarTela, 250));
if (window.visualViewport) window.visualViewport.addEventListener("resize", ajustarTela);
setInterval(ajustarTela, 500);

</script>

